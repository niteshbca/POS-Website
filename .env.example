# ---------------------------------------------------------------------------
# NiteshPro POS website - environment configuration
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Never commit real secrets. Only VITE_* values are exposed to the browser,
# so never put private API keys here.
# ---------------------------------------------------------------------------

# Public site URL used for canonical links, Open Graph tags and the sitemap.
VITE_SITE_URL=https://www.niteshpro.com

# --- Contact details (shown across the site) -------------------------------
VITE_CONTACT_PHONE=+91 90000 00000
VITE_CONTACT_EMAIL=hello@niteshpro.com
VITE_CONTACT_WHATSAPP=919000000000
VITE_WHATSAPP_MESSAGE=Hi NiteshPro team, I'd like to know more about NiteshPro POS.
# Template for the WhatsApp enquiry form. Use {{name}}, {{mobile}}, {{businessType}},
# {{requirement}}, {{city}}, {{message}} placeholders. Use \n for line breaks.
VITE_WHATSAPP_TEMPLATE=
VITE_COMPANY_ADDRESS=Your Business Address, City, State, Country

# --- Form submission endpoints --------------------------------------------
# Point these at your own backend / form service. If they are left empty the
# forms fall back to a prefilled email / WhatsApp handoff so no submission is
# ever silently faked.
VITE_CONTACT_ENDPOINT=
VITE_DEMO_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=
VITE_AUTH_LOGIN_ENDPOINT=
VITE_AUTH_SIGNUP_ENDPOINT=
